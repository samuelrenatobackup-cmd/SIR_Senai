<!DOCTYPE html>
<html lang="pt-BR">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Portal de Acesso — Sistema de Reservas</title>
  <meta name="description" content="Acesse o Sistema de Reservas de Equipamentos com segurança e rapidez." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet" />

  <link rel="stylesheet" href="~/css/login.css" />
</head>

<body>

  <div class="container">
    <!-- PAINEL ESQUERDO -->
    <div class="lado-esquerdo">
      <div class="shape shape-1"></div>
      <div class="shape shape-2"></div>
      <div class="shape shape-3"></div>

      <div>
        <div class="brand">
          <h1>Portal de Acesso</h1>

          <div class="imgMarca">
            <img src="~/imgs/Senai.png">
          </div>

        </div>

        <div class="benefits">
          <h3 class="benefits-title">Benefícios da Plataforma</h3>

          <div class="benefit">
            <div class="benefit-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 8v4l3 3" />
              </svg>
            </div>

            <div class="benefit-text">
              <h3>Acesso Simplificado</h3>
              <p>Entre rapidamente com suas credenciais e acesse todos os recursos da plataforma.</p>
            </div>
          </div>

          <div class="benefit">
            <div class="benefit-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            </div>

            <div class="benefit-text">
              <h3>Segurança Garantida</h3>
              <p>Seus dados estão protegidos com criptografia de ponta e autenticação segura.</p>
            </div>
          </div>

          <div class="benefit">
            <div class="benefit-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>

            <div class="benefit-text">
              <h3>Performance Otimizada</h3>
              <p>Interface rápida e responsiva para melhor experiência de uso.</p>
            </div>
          </div>

          <div class="benefit">
            <div class="benefit-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>
            </div>

            <div class="benefit-text">
              <h3>Suporte Dedicado</h3>
              <p>Equipe disponível para ajudar você a aproveitar ao máximo a plataforma.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="rodape-esquerdo">
        © 2026 Todos os direitos reservados.
      </div>
    </div>

    <div class="divider"></div>

    <!-- PAINEL DIREITO -->
    <div class="lado-direito">
      <div class="conteudo-direito">

        <div class="imgLogin">
          <img src="~/imgs/SIR.png" alt="SIR">
        </div>

        <!-- Abas -->
        <div class="tabs">
          <button class="tab-link active" id="aba-login">Login</button>
          <button class="tab-link" id="aba-cadastro">Cadastro</button>
        </div>

        <!-- FORMULÁRIO LOGIN -->
        <div class="form-panel active" id="painel-login">

          <div class="cabecalho-form">
            <h2>Bem-vindo</h2>
            <p><span class="dot"></span> Entre com suas credenciais para continuar</p>
          </div>

          <form id="form-login" asp-controller="Login" asp-action="AutenticarUsuario" method="post">

            <div class="field">
              <label for="login-email">Email</label>
              <div class="input-wrap">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16v16H4z" stroke="none" />
                  <path d="M22 6 12 13 2 6" />
                  <path d="M2 6h20v12H2z" />
                </svg>

                <input type="email" id="login-email" name="email" placeholder="seu@email.com" autocomplete="email"
                       required />
              </div>
            </div>

            <div class="field">
              <label for="login-senha">Senha</label>

              <div class="input-wrap">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="11" width="18" height="11" rx="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>

                <input type="password" id="login-senha" name="senha" placeholder="••••••••"
                       autocomplete="current-password" required />
              </div>
            </div>

            <div class="row">
              <label class="checkbox-label">
                <input type="checkbox" id="lembrar" name="lembrar" />
                Lembrar-me
              </label>

              <a href="#" class="esqueceu-senha">Esqueceu a senha?</a>
            </div>

            @if (ViewBag.Erro != null)
            {
              <p style="color:red">@ViewBag.Erro</p>
            }

            <button type="submit" class="btn-submit" id="btnEntrar">
              Entrar
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </button>

            <p class="rodape-form">
              Não tem uma conta?
              <a href="#" id="ir-cadastro">Cadastre-se</a>
            </p>

          </form>
        </div>

        <!-- CADASTRO FORM -->
        <!-- FORMULÁRIO CADASTRO -->
          <div class="form-panel" id="painel-cadastro">

            <div class="cabecalho-form">
              <h2>Crie sua conta</h2>
              <p><span class="dot"></span> Preencha os dados para começar</p>
            </div>

            <form id="form-cadastro" asp-controller="Login" asp-action="CadastrarUsuario" method="post">
              @Html.AntiForgeryToken()
              <div class="field-row">

                <div class="field">
                  <label for="cadastro-nome">Nome</label>

                  <div class="input-wrap">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                      <circle cx="12" cy="7" r="4" />
                    </svg>

                    <input type="text" id="cadastro-nome" name="nome" placeholder="Seu nome" autocomplete="given-name"
                           required />
                  </div>
                </div>

                <div class="field">
                  <label for="cadastro-sobrenome">Sobrenome</label>

                  <div class="input-wrap">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                      <circle cx="12" cy="7" r="4" />
                    </svg>

                    <input type="text" id="cadastro-sobrenome" name="sobrenome" placeholder="Sobrenome"
                           autocomplete="family-name" required />
                  </div>
                </div>

              </div>

              <div class="field">
                <label for="cadastro-email">Email</label>

                <div class="input-wrap">
                  <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path d="M4 4h16v16H4z" stroke="none" />
                    <path d="M22 6 12 13 2 6" />
                    <path d="M2 6h20v12H2z" />
                  </svg>

                  <input type="email" id="cadastro-email" name="email" placeholder="seu@email.com" autocomplete="email"
                         required />
                </div>
              </div>

              <div class="field">
                <label for="cadastro-senha">Senha</label>

                <div class="input-wrap">
                  <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>

                  <input type="password" id="cadastro-senha" name="senha" placeholder="••••••••"
                         autocomplete="new-password" required />
                </div>
              </div>

              <div class="field">
                <label for="cadastro-confirmar">Confirmar senha</label>

                <div class="input-wrap">
                  <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                  </svg>

                  <input type="password" id="cadastro-confirmar" name="confirmarSenha" placeholder="••••••••"
                         autocomplete="new-password" required />
                </div>
              </div>

              @if (ViewBag.ErroCadastro != null)
              {
                <p style="color:red">@ViewBag.ErroCadastro</p>
              }

              <button type="submit" class="btn-submit" id="btnCriarConta">
                Criar conta

                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </button>

              <p class="rodape-form">
                Já tem uma conta?
                <a href="#" id="ir-login">Entrar</a>
              </p>

            </form>
          </div>

        </div>
      </div>
    </div>

    <div class="btn-ajuda" title="Ajuda">?</div>

    <script src="~/js/login.js"></script>

  </body>

</html>