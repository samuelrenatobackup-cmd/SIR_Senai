<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Portal de Acesso — Sistema de Reservas</title>
  <meta name="description" content="Acesse o Sistema de Reservas de Equipamentos com segurança e rapidez." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  
  <link rel="stylesheet" href="~/css/login.css" /> 
</head>
<body>

<div class="container">
  <!-- LEFT PANEL -->
  <div class="left">
    <div class="shape shape-1"></div>
    <div class="shape shape-2"></div>
    <div class="shape shape-3"></div>

    <div>
      <div class="brand"><h1>Portal de Acesso</h1></div>

      <div class="benefits">
        <h3 class="benefits-title">Benefícios da Plataforma</h3>

        <div class="benefit">
          <div class="benefit-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          </div>
          <div class="benefit-text">
            <h3>Acesso Simplificado</h3>
            <p>Entre rapidamente com suas credenciais e acesse todos os recursos da plataforma.</p>
          </div>
        </div>

        <div class="benefit">
          <div class="benefit-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="benefit-text">
            <h3>Segurança Garantida</h3>
            <p>Seus dados estão protegidos com criptografia de ponta e autenticação segura.</p>
          </div>
        </div>

        <div class="benefit">
          <div class="benefit-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div class="benefit-text">
            <h3>Performance Otimizada</h3>
            <p>Interface rápida e responsiva para melhor experiência de uso.</p>
          </div>
        </div>

        <div class="benefit">
          <div class="benefit-icon">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="benefit-text">
            <h3>Suporte Dedicado</h3>
            <p>Equipe disponível para ajudar você a aproveitar ao máximo a plataforma.</p>
          </div>
        </div>
      </div>
    </div>

@* 
    <div class="left-footer">© 2026 Todos os direitos reservados.</div> *@


  </div>

  <div class="divider"></div>
  <!-- RIGHT PANEL -->
  <div class="right">
    <!-- Tabs -->
    <div class="Logo_Senai">
    <img src="~/imgs/Senai.png">
    </div>
    <div class="tabs" role="tablist">
      <a href="#" class="tab-link active" id="tab-login" role="tab" aria-selected="true">Login</a>
      <a href="#" class="tab-link" id="tab-cadastro" role="tab" aria-selected="false">Cadastro</a>
    </div>

    <!-- LOGIN FORM -->

      <form id="login-form"
      asp-controller="Login"
      asp-action="Login"
      method="post">

    <div class="field">
        <label for="login-email">Email</label>
        <div class="input-wrap">
            <input type="email"
                   id="login-email"
                   name="email"
                   placeholder="seu@email.com"
                   autocomplete="email"
                   required />
        </div>
    </div>

    <div class="field">
        <label for="login-senha">Senha</label>
        <div class="input-wrap">
            <input type="password"
                   id="login-senha"
                   name="senha"
                   placeholder="••••••••"
                   autocomplete="current-password"
                   required />
        </div>
    </div>

    <div class="row">
        <label class="checkbox-label">
            <input type="checkbox" id="lembrar" />
            <span class="checkbox-box"></span>
            Lembrar-me
        </label>

        <a href="#" class="forgot">Esqueceu a senha?</a>
    </div>

    @if (ViewBag.Erro != null)
    {
        <p style="color:red">@ViewBag.Erro</p>
    }

    <button type="submit" class="btn-submit" id="btn-login">
        Entrar
    </button>

    <p class="form-footer">
        Não tem uma conta?
        <a href="#">Cadastre-se</a>
    </p>

</form>
    </div>
  </div>
</div>

<div class="help-btn" title="Ajuda">?</div>

</body>
</html>
