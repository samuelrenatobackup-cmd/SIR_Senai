      <input type="text" class="search-input" id="search" placeholder="Buscar equipamento..." />
    </div>
    <div class="filter-btns">
      <button class="filter-btn active">Todos</button>
      <button class="filter-btn">Disponível</button>
      <button class="filter-btn">Em Uso</button>
      <button class="filter-btn">Indisponível</button>
    </div>
  </div>



  <!-- Grid -->



  <div class="grid" id="grid">

    <div class="card disponivel">
      <div class="card-top">
        <div class="card-icon">
