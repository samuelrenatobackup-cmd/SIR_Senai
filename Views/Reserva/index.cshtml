@model List<SIR.Models.Equipamento>

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sistema de Reservas</title>

    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/dashboard.css" />
</head>

<body class="dashboard-page">

    <!-- NAVBAR -->
    <nav class="navbar">

        <div class="marca-navbar">

            <div class="marca-icone">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="3" width="20" height="14" rx="2" />
                    <path d="M8 21h8M12 17v4" />
                </svg>
            </div>

            <div class="marca-texto">
                <h1>Sistema de Reservas</h1>
                <p>Monitoramento de Equipamentos</p>
            </div>

        </div>

        <div class="navbar-direita">

            <a asp-controller="Reserva" asp-action="MinhasReservas" class="botao-admin">
                Minhas Reservas
            </a>

            <div class="status-badge">
                <span class="status-dot"></span>
                Online
            </div>

            <a href="/Login" class="botao-admin">
                Sair
            </a>

        </div>

    </nav>

    <!-- CONTEÚDO -->
    <div class="conteudo">

        <!-- ESTATÍSTICAS -->
        <div class="estatisticas">

            <div class="card-estatistica">
                <div class="icone-estatistica total">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" />
                        <rect x="14" y="3" width="7" height="7" />
                        <rect x="14" y="14" width="7" height="7" />
                        <rect x="3" y="14" width="7" height="7" />
                    </svg>
                </div>

                <div class="info-estatistica">
                    <label>Total de Equipamentos</label>
                    <div class="numero">@Model.Count()</div>
                </div>
            </div>

            <div class="card-estatistica">
                <div class="icone-estatistica disponivel">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                    </svg>
                </div>

                <div class="info-estatistica">
                    <label>Disponíveis</label>
                    <div class="numero">@Model.Count(e => e.QuantidadeDisponivel > 0)</div>
                </div>
            </div>

            <div class="card-estatistica">
                <div class="icone-estatistica uso">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path
                        d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                    </svg>
                </div>

                <div class="info-estatistica">
                    <label>Em Uso</label>
                    <div class="numero">
                        @Model.Count(e => e.QuantidadeDisponivel < e.QuantidadeTotal && e.QuantidadeDisponivel > 0)
                    </div>
                </div>
            </div>

            <div class="card-estatistica">
                <div class="icone-estatistica indisponivel">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path
                        d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                </div>

                <div class="info-estatistica">
                    <label>Indisponíveis</label>
                    <div class="numero">@Model.Count(e => e.QuantidadeDisponivel == 0)</div>
                </div>
            </div>

        </div>

        <!-- TOOLBAR -->
        <div class="barra-ferramentas">

            <div class="area-pesquisa">

                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>

                <input type="text" class="input-pesquisa" id="search" placeholder="Buscar equipamento..." />

            </div>

            <div class="botoes-filtro">
                <button class="botao-filtro ativo" data-filter="todos">Todos</button>
                <button class="botao-filtro" data-filter="disponivel">Disponíveis</button>
                <button class="botao-filtro" data-filter="em-uso">Em uso</button>
                <button class="botao-filtro" data-filter="indisponivel">Indisponíveis</button>
            </div>

        </div>

        <!-- GRID -->
        <div class="grid" id="grid">

            <div id="semResultados" class="sem-resultados" style="display:none;">
                Nenhum equipamento encontrado.
            </div>

            @foreach (var equipamento in Model)
            {
                var classeStatus = equipamento.Status switch
                {
                    "Disponível" => "disponivel",
                    "Em Uso" => "em-uso",
                    "Indisponível" => "indisponivel",
                    _ => "disponivel"
                };

                <div class="card @classeStatus" data-status="@classeStatus">

                    <div class="card-top">

                        <div class="card-icon">
                            <img src="~/imgs/@equipamento.Icone" alt="@equipamento.Nome" class="icone-equipamento">
                        </div>

                        <div class="card-meta">
                            <div class="label">Equipamento</div>
                            <h3>@equipamento.Nome</h3>
                        </div>

                    </div>

                    <div class="card-row">

                        <span class="status-pill @classeStatus">
                            @equipamento.Status
                        </span>

                        <div class="card-qty">
                            <span>Empréstimos</span>
                            <strong>@equipamento.QuantidadeEmprestada/@equipamento.QuantidadeTotal</strong>
                        </div>

                    </div>

                    @if (equipamento.Status == "Disponível" || equipamento.Status == "Parcial")
                    {
                        <form asp-controller="Reserva" asp-action="ConfirmarEmprestimo" method="get">

                            <input type="hidden" name="equipamentoId" value="@equipamento.Id" />

                            <button type="submit" class="btn-emprestar active">
                                Emprestar
                            </button>

                        </form>
                    }

                </div>
            }

        </div>

    </div>

    <footer class="rodape">

        <div class="rodape-marca">

            <div class="rodape-texto">
                <strong>SENAI</strong>
                <span>Sistema de Monitoramento de Reservas</span>
            </div>

        </div>

        <div class="rodape-direita">
            <span>©2026 — Todos os direitos reservados</span>
            <span class="versao">v1.0.0</span>
        </div>

    </footer>


    <script src="~/js/Reserva.js"></script>

</body>

</html>