@model List<SIR.Models.Reserva>

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Minhas Reservas — Sistema de Reservas</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/minhasReservas.css" />
</head>

<body>

    <!-- ===== NAVBAR ===== -->
    <nav class="navbar">

        <div class="marca-navbar">
            <div class="marca-icone">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="3" width="20" height="14" rx="2" />
                    <path d="M8 21h8M12 17v4" />
                </svg>
            </div>
            <div class="marca-texto">
                <h1>Sistema de Reservas</h1>
                <p>Monitoramento de Equipamentos</p>
            </div>
        </div>

        <div class="navbar-direita">
            <a asp-controller="Reserva" asp-action="ListarEquipamentos" class="botao-admin">
                Equipamentos
            </a>
            <div class="status-badge">
                <span class="status-dot"></span>
                Online
            </div>
            <a href="/Login" class="botao-admin">Sair</a>
        </div>

    </nav>

    <!-- ===== CONTEÚDO PRINCIPAL ===== -->
    <main class="conteudo-reservas">

        <!-- Cabeçalho da seção -->
        <div class="cabecalho-secao">
            <div class="cabecalho-linha"></div>
            <div class="cabecalho-texto">
                <h2>Minhas Reservas</h2>
                <p>Visualize e acompanhe suas reservas</p>
            </div>
        </div>

        <!-- Grid de cards -->
        <div class="grid-reservas">

            @if (Model == null || !Model.Any())
            {
                <div class="sem-reservas">
                    Nenhuma reserva encontrada.
                </div>
            }
            else
            {
                @foreach (var reserva in Model)
                {
                    @* Lógica de status — ajuste conforme o campo real do seu model *@
                    var statusClasse = reserva.Status == "Finalizado" ? "finalizado"
                            : reserva.Status == "Pendente" ? "pendente"
                            : "ativo";

                    var statusLabel = statusClasse == "ativo" ? "Ativo"
                    : statusClasse == "finalizado" ? "Finalizada"
                    : "Pendente";

                    var codigoReserva = $"RES-{reserva.Id:D3}";

                    @* Ícone emoji do equipamento (usa o campo Icone se existir, senão padrão) *@
                    var iconeEquip = reserva.Equipamento?.Icone ?? "📦";

                    <div class="card-reserva">

                        <!-- Ícone do equipamento -->
                <div class="card-reserva-icone">
                            <div class="icone-wrapper">
                                @iconeEquip
                            </div>
                        </div>

                        <!-- Nome e código -->
                <div class="card-reserva-nome">
                            <h3>@reserva.Equipamento?.Nome</h3>
                            <span class="card-reserva-codigo">@codigoReserva</span>
                        </div>

                        <!-- Linhas de informação -->
                <div class="card-reserva-info">

                            <!-- Status -->
                    <div class="info-linha">
                                <div class="info-linha-esquerda">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10" />
                                        <polyline points="12 6 12 12 16 14" />
                                    </svg>
                                    Status
                                </div>
                                <span class="status-pill-linha @statusClasse">
                                    @if (statusClasse == "ativo")
                                    {
                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                            <circle cx="12" cy="12" r="10" />
                                            <path d="M9 12l2 2 4-4" />
                                        </svg>
                                    }
                                    else if (statusClasse == "finalizado")
                                    {
                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                            <circle cx="12" cy="12" r="10" />
                                            <line x1="12" y1="8" x2="12" y2="12" />
                                            <line x1="12" y1="16" x2="12.01" y2="16" />
                                        </svg>
                                    }
                                    @statusLabel
                                </span>
                            </div>

                            <!-- Data de Retirada -->
                    <div class="info-linha">
                                <div class="info-linha-esquerda">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" />
                                        <line x1="16" y1="2" x2="16" y2="6" />
                                        <line x1="8" y1="2" x2="8" y2="6" />
                                        <line x1="3" y1="10" x2="21" y2="10" />
                                    </svg>
                                    Retirada
                                </div>
                                <span class="info-linha-valor">
                                    @reserva.DataReserva.ToString("dd/MM/yyyy")
                                </span>
                            </div>

                            <!-- Data de Devolução -->
                    <div class="info-linha">
                                <div class="info-linha-esquerda">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" />
                                        <line x1="16" y1="2" x2="16" y2="6" />
                                        <line x1="8" y1="2" x2="8" y2="6" />
                                        <line x1="3" y1="10" x2="21" y2="10" />
                                    </svg>
                                    Devolução
                                </div>
                                <span class="info-linha-valor">
                                    @reserva.HoraDevolucaoPrevista.ToString(@"hh\:mm")
                                </span>
                            </div>

                            <!-- Horário de Retirada -->
                    <div class="info-linha">
                                <div class="info-linha-esquerda">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="10" />
                                        <polyline points="12 6 12 12 16 14" />
                                    </svg>
                                    Horário
                                </div>
                                <span class="info-linha-valor">
                                    @reserva.HoraReserva.ToString(@"hh\:mm")
                                </span>
                            </div>

                        </div>

                        <!-- Botão de ação -->
                        @if (statusClasse == "finalizado")
                        {
                            <button class="btn-devolucao devolvido" disabled>
                                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <circle cx="12" cy="12" r="10" />
                                    <path d="M9 12l2 2 4-4" />
                                </svg>
                                Devolvido
                            </button>
                        }
                        else
                        {
                            <button class="btn-devolucao vermelho"
                    onclick="abrirModal('@reserva.Id', '@reserva.Equipamento?.Nome')">
                                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <polyline points="1 4 1 10 7 10" />
                                    <path d="M3.51 15a9 9 0 1 0 .49-3.54" />
                                </svg>
                                Confirmar Devolução
                            </button>
                        }

                    </div>
                }
            }

        </div>
    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="rodape">

        <div class="rodape-marca">
            <div class="rodape-icone">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="8" r="4" />
                    <path d="M19.5 20a7.5 7.5 0 0 0-15 0" />
                </svg>
            </div>
            <div class="rodape-texto">
                <strong>Instituição</strong>
                <span>Sistema de Monitoramento de Reservas</span>
            </div>
        </div>

        <div class="rodape-direita">
            <span>© 2026 — Todos os direitos reservados</span>
            <span class="versao">v1.0.0</span>
        </div>

    </footer>

    <!-- ===== BOTÃO AJUDA ===== -->
    <div class="help-btn" title="Ajuda">?</div>

    <!-- ===== MODAL DE CONFIRMAÇÃO DE DEVOLUÇÃO ===== -->
    <div class="modal-overlay" id="modalOverlay">
        <div class="modal">

            <div class="modal-icone">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"
                    style="width:32px;height:32px;color:#e63946">
                    <polyline points="1 4 1 10 7 10" />
                    <path d="M3.51 15a9 9 0 1 0 .49-3.54" />
                </svg>
            </div>

            <h3>Confirmar Devolução</h3>
            <p>
                Confirmar a devolução de <strong id="modalNomeEquipamento">—</strong>?<br />
                Esta ação não pode ser desfeita.
            </p>

            <div class="modal-acoes">

                <button class="btn-modal cancelar" onclick="fecharModal()">
                    Cancelar
                </button>

                <form id="formDevolucao" asp-controller="Reserva" asp-action="ConfirmarDevolucao" method="post"
                    style="flex:1;display:contents;">

                    @Html.AntiForgeryToken()
                    <input type="hidden" id="modalReservaId" name="reservaId" value="" />

                    <button type="submit" class="btn-modal confirmar">
                        Confirmar
                    </button>

                </form>

            </div>

        </div>
    </div>

    <!-- ===== SCRIPTS ===== -->
    <script src="~/js/MinhasReservas.js"></script>

</body>

</html>
