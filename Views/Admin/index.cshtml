@model List<SIR.Models.Reserva>

<head>
    <link rel="icon" type="image/png" href="~/imgs/favicon.ico" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reservas - SIR</title>

    <!-- Fonte Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Seu CSS -->
    <link rel="stylesheet" href="~/css/admin.css" />
</head>

<div class="admin-shell">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <a href="#" class="sidebar__brand">
            <div class="sidebar__brand-icon">A</div>

            <div>
                <div class="sidebar__brand-name">
                    Admin Panel
                </div>

                <small style="color: var(--text-secondary);">
                    voltar ao sistema
                </small>
            </div>
        </a>

        <nav class="sidebar__nav">

            <a href="#" class="ativo">
                <i class="fa-solid fa-calendar-check"></i>
                <span>Reservas</span>
            </a>

            @*
            <a asp-controller="Usuario"
               asp-action="Index">
                <i class="fa-solid fa-users"></i>
                <span>Usuários</span>
            </a>

            <a asp-controller="Equipamento"
               asp-action="Create">
                <i class="fa-solid fa-plus-circle"></i>
                <span>Adicionar Equipamentos</span>
            </a>
            *@

        </nav>

        <div class="sidebar__footer">

            <a asp-controller="Login" asp-action="Logout" class="sidebar__logout">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Sair</span>
            </a>

            @* <div class="sidebar__senai">
                <div class="sidebar__senai-badge">
                    SENAI
                </div>
            </div> *@

        </div>

    </aside>

    <!-- CONTEÚDO -->
    <main class="conteudo-principal">

        <div class="pagina-cabecalho">

            <div>
                <h1 class="pagina-titulo">Reservas</h1>

                <p class="pagina-subtitulo">
                    Gerenciamento de equipamentos reservados
                </p>
            </div>

        </div>

        <div class="tabela-container">

            <!-- BARRA -->
            <div class="tabela-barra">

                <div class="tabela-busca">
                    <i class="fa-solid fa-magnifying-glass"></i>

                    <input type="text" id="campoBusca" placeholder="Buscar equipamento ou usuário..."
                           class="tabela-busca__input" />
                </div>

            </div>

            <!-- TABELA -->
            <div class="tabela-wrapper">

                <table class="tabela">

                    <thead class="tabela__cabecalho">
                        <tr>
                            <th>ID</th>
                            <th>Usuário</th>
                            <th>Equipamento</th>
                            <th>Status</th>
                            <th>Reserva</th>
                            <th>Devolução</th>
                        </tr>
                    </thead>

                    <tbody class="tabela__corpo">

                        @foreach (var reserva in Model)
                        {
                            <tr class="tabela__linha">

                                <!-- ID -->
                                <td class="tabela__id" data-label="ID">
                                    #@reserva.Id
                                </td>

                                <!-- USUÁRIO -->
                                <td class="tabela__usuario" data-label="Usuário">

                                    <div class="usuario-avatar">
                                        @(
                                            !string.IsNullOrEmpty(reserva.Usuario?.Nome)
                                            ? reserva.Usuario.Nome.Substring(0, 1)
                                            : "?"
                                        )
                                    </div>

                                    <span>
                                        @(reserva.Usuario?.Nome ?? "Sem usuário")
                                    </span>

                                </td>

                                <!-- EQUIPAMENTO -->
                                <td class="tabela__equipamento" data-label="Equipamento">
                                    <span>
                                        @(reserva.Equipamento?.Nome ?? "Sem equipamento")
                                    </span>
                                </td>

                                <!-- STATUS -->
                                <td data-label="Status">

                                    @if (reserva.Status == "Ativo" || reserva.Status == "Finalizado")
                                    {
                                        <span class="etiqueta-status etiqueta-status--ativo">
                                            @reserva.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="etiqueta-status etiqueta-status--inativo">
                                            @reserva.Status
                                        </span>
                                    }

                                </td>

                                <!-- DATA RESERVA -->
                                <td data-label="Reserva">
                                    @reserva.DataReserva.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <!-- DATA DEVOLUÇÃO -->
                                <td data-label="Devolução">
                                    @(reserva.DataDevolucao?.ToString("dd/MM/yyyy HH:mm")
                                        ?? "Pendente")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- RODAPÉ -->
            <div class="tabela-rodape">

                <span class="tabela-rodape__info" id="contadorReservas">
                    Mostrando @Model.Count reserva(s)
                </span>

            </div>

        </div>

    </main>

</div>

<script src="~/js/Admin.js">

</script>