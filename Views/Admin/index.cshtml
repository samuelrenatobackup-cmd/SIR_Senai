@model List<SIR.Models.Reserva>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reservas - SIR</title>

    <!-- Fonte Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <!-- Seu CSS -->
    <link rel="stylesheet" href="~/css/admin.css" />
</head>


<div class="admin-shell">


<aside class="sidebar">

    <a href="#" class="sidebar__brand">
        <div class="sidebar__brand-icon">A</div>

        <div>
            <div class="sidebar__brand-name">
                Admin Panel
            </div>

            <small style="color: var(--text-secondary);">
                voltar ao sistema
            </small>
        </div>
    </a>

    <nav class="sidebar__nav">

        <a asp-controller="Admin"
           asp-action="Reservas"
           class="ativo">
            <i class="fa-solid fa-calendar-check"></i>
            <span>Reservas</span>
        </a>

        <a asp-controller="Usuario"
           asp-action="Index">
            <i class="fa-solid fa-users"></i>
            <span>Usuários</span>
        </a>

        <a asp-controller="Equipamento"
           asp-action="Create">
            <i class="fa-solid fa-plus-circle"></i>
            <span>Adicionar Equipamentos</span>
        </a>

    </nav>

    <div class="sidebar__footer">

        <a asp-controller="Login"
           asp-action="Logout"
           class="sidebar__logout">
            <i class="fa-solid fa-right-from-bracket"></i>
            <span>Sair</span>
        </a>

        <div class="sidebar__senai">
            <div class="sidebar__senai-badge">
                SENAI
            </div>
        </div>

    </div>

</aside>

<main class="conteudo-principal">

    <div class="pagina-cabecalho">

        <div>
            <h1 class="pagina-titulo">Reservas</h1>

            <p class="pagina-subtitulo">
                Gerenciamento de equipamentos reservados
            </p>
        </div>

        <a href="#"
           class="btn-nova-reserva">
            <i class="fa-solid fa-plus"></i>
            Nova Reserva
        </a>

    </div>

    <div class="tabela-container">

        <div class="tabela-barra">

            <div class="tabela-busca">
                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       placeholder="Buscar equipamento ou usuário..."
                       class="tabela-busca__input" />
            </div>

        </div>

        <table class="tabela">

            <thead class="tabela__cabecalho">
                <tr>
                    <th>ID</th>
                    <th>Usuário</th>
                    <th>Equipamento</th>
                    <th>Status</th>
                    <th>Reserva</th>
                    <th>Devolução</th>
                </tr>
            </thead>

            <tbody class="tabela__corpo">

                @foreach (var reserva in Model)
                {
                    <tr class="tabela__linha">

                        <td class="tabela__id">
                            #@reserva.Id
                        </td>

                        <td class="tabela__usuario">

                            <div class="usuario-avatar">
                                @(
                                    !string.IsNullOrEmpty(reserva.Usuario?.Nome)
                                    ? reserva.Usuario.Nome.Substring(0,1)
                                    : "?"
                                )
                            </div>

                            <span>
                                @(reserva.Usuario?.Nome ?? "Sem usuário")
                            </span>

                        </td>

                        <td class="tabela__equipamento">
                            <span>
                                @(reserva.Equipamento?.Nome ?? "Sem equipamento")
                            </span>
                        </td>

                        <td>

                            @if (reserva.Status == "Ativo")
                            {
                                <span class="etiqueta-status etiqueta-status--ativo">
                                    Ativo
                                </span>
                            }
                            else
                            {
                                <span class="etiqueta-status etiqueta-status--inativo">
                                    @reserva.Status
                                </span>
                            }

                        </td>

                        <td>
                            @reserva.DataReserva.ToString("dd/MM/yyyy HH:mm")
                        </td>

                        <td>
                            @(reserva.DataDevolucao?.ToString("dd/MM/yyyy HH:mm")
                                ?? "Pendente")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <div class="tabela-rodape">

            <span class="tabela-rodape__info">
                Mostrando @Model.Count reserva(s)
            </span>

        </div>

    </div>

</main>

</div>
